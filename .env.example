# BACOWR Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# API Key for your chosen provider
# Get Anthropic key from: https://console.anthropic.com/
# Get OpenAI key from: https://platform.openai.com/api-keys
LLM_API_KEY=your_api_key_here

# Model to use (optional - uses provider default if not specified)
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# OpenAI: gpt-4o, gpt-4-turbo
LLM_MODEL=

# Maximum tokens to generate per article (default: 4000)
LLM_MAX_TOKENS=4000

# Temperature for generation 0-1 (default: 0.7)
# Lower = more focused, Higher = more creative
LLM_TEMPERATURE=0.7

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Path where articles, jobs, and metadata will be stored
# Relative paths are relative to project root
STORAGE_PATH=./output

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API server host (default: 0.0.0.0)
API_HOST=0.0.0.0

# API server port (default: 8000)
API_PORT=8000

# Enable auto-reload during development (default: false in production)
API_RELOAD=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# PREFLIGHT CONFIGURATION
# =============================================================================

# HTTP timeout for fetching target pages (seconds)
PREFLIGHT_TIMEOUT=30

# Maximum number of paragraphs to extract from target
PREFLIGHT_MAX_PARAGRAPHS=3

# User-Agent for HTTP requests
PREFLIGHT_USER_AGENT=Mozilla/5.0 (compatible; BACOWR/1.0)

# =============================================================================
# HEAVY PREFLIGHT (v2.0) - Optional
# =============================================================================

# SERP API Key (future integration with SerpApi, Dataforseo, etc.)
# Leave empty to use simulated SERP data
# SERP_API_KEY=

# =============================================================================
# OPTIONAL: ADVANCED SETTINGS
# =============================================================================

# Enable CORS (for frontend development)
# ENABLE_CORS=true

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Enable request logging
# LOG_REQUESTS=true

# Maximum concurrent jobs (for future batch processing)
# MAX_CONCURRENT_JOBS=5
